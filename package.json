{
  "name": "lockon-ewac",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:wordlists": "node scripts/sync-wordlists.mjs",
    "predev": "npm run sync:wordlists",
    "dev": "vite",
    "prebuild": "npm run sync:wordlists",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:localization": "esbuild src/lib/localization.ts --bundle --format=esm --platform=node --outfile=.test-build/localization.mjs --log-level=error && node --test tests/localization.test.mjs",
    "test": "npm run test:localization && npm run test:ipc && npm run test:vault && npm run test:numbers && npm run test:html && npm run test:risk && npm run test:csv && npm run test:db && npm run test:archive && npm run test:assemble && npm run test:severity && npm run test:signal && npm run test:router && npm run test:mission && npm run test:stores && npm run test:csp-reporter && npm run test:kmz && npm run test:basemap && npm run test:cidr && npm run test:gps && npm run test:livemap && npm run test:aprisk && npm run test:exports",
    "test:csv": "esbuild src/lib/csv.ts --bundle --format=esm --platform=node --outfile=.test-build/csv.mjs --log-level=error && node --test tests/csv.test.mjs",
    "test:risk": "esbuild src/lib/riskEngine.ts --bundle --format=esm --platform=node --outfile=.test-build/riskEngine.mjs --log-level=error && node --test tests/riskEngine.test.mjs",
    "test:ipc": "esbuild src/lib/ipc.ts --bundle --format=esm --platform=node --outfile=.test-build/ipc.mjs --log-level=error --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs && node --test tests/ipc.test.mjs",
    "test:components": "vitest run --config vitest.config.ts",
    "test:components:watch": "vitest --config vitest.config.ts",
    "test:html": "esbuild src/lib/html.ts --bundle --format=esm --platform=node --outfile=.test-build/html.mjs --log-level=error && node --test tests/html.test.mjs",
    "test:numbers": "esbuild src/lib/numbers.ts --bundle --format=esm --platform=node --outfile=.test-build/numbers.mjs --log-level=error && node --test tests/numbers.test.mjs",
    "test:vault": "esbuild tests/entries/vault.ts --bundle --format=esm --platform=node --outfile=.test-build/vault.mjs --log-level=error --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql.mjs && node --test tests/vaultCrypto.test.mjs",
    "test:db": "esbuild tests/entries/db.ts --bundle --format=esm --platform=node --outfile=.test-build/db.mjs --log-level=error --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql-sqlite.mjs --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs && node --no-warnings --test tests/database.test.mjs",
    "test:csp-reporter": "esbuild src/lib/cspReporter.ts --bundle --format=esm --platform=node --outfile=.test-build/cspReporter.mjs --log-level=error --define:import.meta.env.DEV=false && node --test tests/cspReporter.test.mjs",
    "test:stores": "esbuild tests/entries/db.ts --bundle --format=esm --platform=node --outfile=.test-build/db.mjs --log-level=error --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql-sqlite.mjs --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs && node --no-warnings --test tests/stores.test.mjs",
    "test:mission": "esbuild tests/entries/db.ts --bundle --format=esm --platform=node --outfile=.test-build/db.mjs --log-level=error --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql-sqlite.mjs --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs && node --no-warnings --test tests/missionStore.test.mjs",
    "test:router": "esbuild tests/entries/db.ts --bundle --format=esm --platform=node --outfile=.test-build/db.mjs --log-level=error --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql-sqlite.mjs --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs && node --no-warnings --test tests/engineRouter.test.mjs",
    "test:signal": "esbuild src/lib/signalStyle.ts --bundle --format=esm --platform=node --outfile=.test-build/signalStyle.mjs --log-level=error && node --test tests/signalStyle.test.mjs",
    "test:severity": "esbuild src/lib/severityStyle.ts --bundle --format=esm --platform=node --outfile=.test-build/severityStyle.mjs --log-level=error && node --test tests/severityStyle.test.mjs",
    "test:assemble": "esbuild tests/entries/db.ts --bundle --format=esm --platform=node --outfile=.test-build/db.mjs --log-level=error --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql-sqlite.mjs --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs && node --no-warnings --test tests/assemble.test.mjs",
    "test:archive": "esbuild tests/entries/archive.ts --bundle --format=esm --platform=node --outfile=.test-build/archive.mjs --log-level=error --loader:.css=empty --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql.mjs && node --test tests/archive.test.mjs",
    "test:exports": "esbuild tests/entries/exports.ts --bundle --format=esm --platform=node --outfile=.test-build/exports.mjs --log-level=error --loader:.css=empty --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql.mjs && node --test tests/exports.test.mjs",
    "test:aprisk": "esbuild tests/entries/apRisk.ts --bundle --format=esm --platform=node --outfile=.test-build/apRisk.mjs --log-level=error && node --test tests/apRisk.test.mjs",
    "test:livemap": "esbuild tests/entries/liveMap.ts --bundle --format=esm --platform=node --outfile=.test-build/liveMap.mjs --log-level=error --loader:.css=empty --alias:@tauri-apps/plugin-shell=./tests/stubs/plugin-shell.mjs --alias:@tauri-apps/plugin-sql=./tests/stubs/plugin-sql.mjs && node --test tests/liveMap.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:migrations": "node scripts/check-migration-eol.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "test:kmz": "esbuild src/lib/report/kmz.ts --bundle --format=esm --platform=node --outfile=.test-build/kmz.mjs --log-level=error && node --test tests/kmz.test.mjs",
    "check:cleartext": "node scripts/check-cleartext-urls.mjs",
    "test:basemap": "esbuild src/lib/basemapStyle.ts --bundle --format=esm --platform=node --outfile=.test-build/basemapStyle.mjs --log-level=error && node --test tests/basemap.test.mjs",
    "check:kmz": "node scripts/check-kmz-assets.mjs",
    "test:gps": "esbuild tests/entries/gps.ts --bundle --format=esm --platform=node --outfile=.test-build/engineStore.mjs --log-level=error && node --test tests/gpsAccepted.test.mjs",
    "test:cidr": "esbuild src/lib/cidr.ts --bundle --format=esm --platform=node --outfile=.test-build/cidr.mjs --log-level=error && node --test tests/cidr.test.mjs",
    "check:installer": "node scripts/check-installer.mjs",
    "check:risk-claims": "node scripts/check-risk-claims.mjs",
    "check:map": "node scripts/check-map-parity.mjs",
    "check:glow": "node scripts/check-no-glow.mjs",
    "check:icons": "node scripts/check-card-icons.mjs",
    "basemap:glyphs": "node scripts/fetch-basemap-glyphs.mjs",
    "test:basemap:runtime": "node scripts/check-basemap-runtime.mjs",
    "kml:icons": "python scripts/make-kml-icons.py",
    "check:fonts:runtime": "node scripts/check-fonts-runtime.mjs",
    "fonts:refresh": "node scripts/refresh-fonts.mjs",
    "check:margins": "node scripts/check-report-margins.mjs",
    "check:severity-css": "node scripts/check-severity-classes.mjs",
    "check:sidecar": "node scripts/check-sidecar-resources.mjs",
    "test:csp": "node scripts/csp-smoke-test.mjs",
    "test:csp:release": "node scripts/csp-smoke-test.mjs --release",
    "test:export": "node scripts/export-smoke-test.mjs",
    "test:export:release": "node scripts/export-smoke-test.mjs --release",
    "test:pdfdiff": "node scripts/pdfdiff.mjs --self-test",
    "benchmark": "node scripts/benchmark.mjs",
    "check:ci": "node scripts/check-ci-parity.mjs",
    "previews": "node scripts/capture-previews.mjs",
    "check:wordlists": "node scripts/check-wordlists.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "maplibre-gl": "^5.23.0",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.3"
  }
}
