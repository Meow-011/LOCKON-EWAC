{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LOCKON EWAC default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ewac-engine/ewac-engine",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
